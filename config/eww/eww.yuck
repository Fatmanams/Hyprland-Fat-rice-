;; eww.yuck — demo widget bar at the top-right corner of the screen.
;; The rice's primary bar is waybar; this is a small eww widget bar so
;; the AUR-built eww binary is actually exercised and has something to
;; render. To remove entirely: comment out the `eww open bar_main` line
;; in hyprland.conf and drop eww from 10-aur.sh — waybar covers the
;; status-bar role on its own.
;;
;; Color variables are sourced by eww's FFI mechanism; see eww.scss for
;; the mapping. Editing colors here is wrong — update eww.scss instead.
;;
;; STRUCTURE: defvars hold state, the defpoll blocks at the bottom
;; refresh them on a timer, the defwidget describes the layout, and the
;; defwindow places it on screen. To extend: add a defpoll + a matching
;; label in bar_main. Started by hyprland.conf's `eww open bar_main`.

;; Initial values — replaced by the defpoll blocks below within 5s.
(defvar date_time "loading...")
(defvar cpu_usage 0)
(defvar mem_usage 0)

;; The widget itself: a horizontal box of labels. The :class names map
;; to CSS selectors in eww.scss.
(defwidget bar_main []
  (box :class "bar" :orientation "h" :space-evenly false :spacing 8
    (label :class "clock" :text date_time)
    (label :class "sep" :text "|")
    (label :class "cpu" :text "CPU ${cpu_usage}%")
    (label :class "sep" :text "|")
    (label :class "mem" :text "MEM ${mem_usage}%")))

;; Window placement: anchored top-right, non-exclusive (shares the bar
;; area with waybar), unfocusable so it never steals keyboard focus.
(defwindow bar_main
  :monitor 0
  :geometry (geometry :x "0"
                      :y "0"
                      :width "auto"
                      :height "32"
                      :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable false
  (bar_main))

;; Pollers — interval in milliseconds. Cheap, so 5s is fine.
(defpoll date_time :interval "5s"
  "date '+%H:%M  %d %b'")
(defpoll cpu_usage :interval "5s"
  "top -bn1 | grep 'Cpu(s)' | awk '{print int(100 - $8)}'")
(defpoll mem_usage :interval "5s"
  "free | awk '/Mem:/ {print int($3/$2 * 100)}'")
