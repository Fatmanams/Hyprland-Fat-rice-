# =============================================================================
# ghostty config  —  primary terminal. Matches the rice.
#
# Single monitor, AMD/Intel iGPU. No NVIDIA env needed.
# Font: JetBrainsMono Nerd Font (pacman: ttf-jetbrains-mono-nerd, 00-base.sh).
# Color palette baked here as Catppuccin Mocha; pywal16 also writes a live
# palette to ~/.cache/wal/colors.json when it runs, but Ghostty reads its
# own config file rather than importing CSS — so the dynamic palette
# doesn't auto-apply. If you want pywal-driven Ghostty colors, write a
# small post-wal hook that regenerates ~/.config/ghostty/colors.conf and
# `ghostty +reload-config`s running windows. Left as a TODO in the README.
# =============================================================================

# ---- Font ----------------------------------------------------------------
font-family = JetBrainsMono Nerd Font
font-size = 13
font-feature = -calt
font-feature = -liga

# ---- Window -------------------------------------------------------------
window-padding-x = 12
window-padding-y = 10
window-decoration = false
window-theme = ghostty
background-opacity = 0.95
background-blur-radius = 20

# ---- Keys ---------------------------------------------------------------
# Make Ctrl+Shift+C/V copy/paste, default on most setups.
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
# Confirm closing windows with work in progress
confirm-close-surface = false
# Don't quit when last window closes — keep ghostty running for faster
# subsequent launches. Comment out if you want strict macOS-style behavior.
quit-after-last-window-closed = false

# ---- Cursor ------------------------------------------------------------
cursor-style = bar
cursor-style-blink = true

# ---- Shell + working dir ------------------------------------------------
command = /usr/bin/fish   # installed by 00-base.sh; verify path with `which fish`
working-directory = home

# ---- Catppuccin Mocha (baked default; pywal override noted above) -------
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#bac2de
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#a6adc8
background = 1e1e2e
foreground = cdd6f4
selection-background = 585b70
selection-foreground = cdd6f4
cursor-color = f5e0dc
