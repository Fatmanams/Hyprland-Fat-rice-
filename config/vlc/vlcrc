[core]

# Snapshot location. VLC does NO tilde (~) expansion on snapshot-path
# (verified against VLC 3.0's src/video_output/snapshot.c — it
# vlc_stat()s the raw string), so @HOME@ is substituted with the real
# home dir by 30-dotfiles.sh at install time. VLC also does NOT create
# the directory itself — 30-dotfiles.sh mkdirs it.
snapshot-path=@HOME@/Pictures/vlc-snapshots

# Sequential numbers (vlcsnap-0001.png, ...) instead of timestamps —
# readable order, and two same-second snapshots can't overwrite each
# other. Verified option name via `vlc -H --advanced`.
snapshot-sequential=1

# avcodec-hw defaults to "any" (auto hardware-decode with software
# fallback) — verified against `vlc -H --advanced` output directly, not
# assumed. Deliberately not overridden: per-backend values (e.g. vaapi)
# CAN be forced, but community reports on AMD+Wayland hardware-decode
# forcing are mixed enough that the working default is the safer
# choice. If 4K/AV1 playback stutters on the Vega 7 iGPU, check
# Tools > Codec Information while a video is playing before changing
# anything here.
